    "te_cols = [\n",
    "    \"patient_id\",\n",
    "    \"clinic_id\",\n",
    "    \"clinic_specialty\",\n",
    "    \"booking_channel\",\n",
    "    \"hour_group\",\n",
    "    \"clinic_dow_combo\",\n",
